@using WeatherAppMVC.Models.Weather
@model WeatherModel
@{
    ViewData["Title"] = "Weather App";
}

<h2>Weather Forecast</h2>

<form method="post" asp-action="GetWeather" class="weather-form">
    <label for="cityName">Enter city:</label>
    <input type="text" id="cityName" name="cityName" value="@ViewBag.LastCity" required />
    <button type="submit" class="submit-button">Get Weather</button>
</form>

@if (ViewBag.Error != null)
{
    <div class="alert alert-error">@ViewBag.Error</div>
}

@if (ViewBag.RainWarning != null)
{
    <div class="alert alert-warning">@ViewBag.RainWarning</div>
}

@if (Model != null)
{
    <h3>Weather in @Model.CityName</h3>
    <p>Max Temperature: @Model.Temperature.MaxTemperature °C</p>
    <p>Min Temperature: @Model.Temperature.MinTemperature °C</p>

    <ul class="weather-conditions">
        @foreach (var condition in Model.Conditions)
        {
            <li>Condition: @condition.Condition</li>
        }
    </ul>
}